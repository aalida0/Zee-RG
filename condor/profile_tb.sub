universe = vanilla
executable = profile_tb.sh
environment = "DIRECT=1"
arguments = $(start) $(tb)
output = $ENV(HOME)/zee_env/logs/ptb.out.$(Cluster).$(Process)
error = $ENV(HOME)/zee_env/logs/ptb.err.$(Cluster).$(Process)
log = $ENV(HOME)/zee_env/logs/ptb.log
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = profile_tb.sh
+queue = "short"
request_cpus = 1
request_memory = 4GB
